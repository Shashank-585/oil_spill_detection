# Set default behavior to automatically handle line endings
* text=auto eol=lf

# Explicitly declare text files you want to always be normalized and converted to LF on checkout
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.css text eol=lf
*.html text eol=lf

# Declare binary files to prevent corruption
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.tif binary
*.tiff binary
*.nc binary
*.geotiff binary
*.gz binary
*.zip binary
