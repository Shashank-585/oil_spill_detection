# SIH26143 Maritime Oil Spill Attribution Pipeline - Environment Variables
# Copy this file to .env and populate with your credentials. Never commit .env to source control!

# Project Root & Logging
LOG_LEVEL=INFO

# Planetary Computer / Microsoft Azure (Optional - SAS tokens are generated automatically)
PLANETARY_COMPUTER_API_KEY=

# Copernicus Marine Service (CMEMS) Credentials (Optional for Phase 2 automated ingestion)
COPERNICUS_MARINE_USERNAME=
COPERNICUS_MARINE_PASSWORD=

# ECMWF / Copernicus Climate Data Store (CDS) Credentials (Optional for ERA5 direct CDS downloads)
CDSAPI_URL=https://cds.climate.copernicus.eu/api/v2
CDSAPI_KEY=

# Database / PostGIS (Optional for later phases)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=oilspill_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
